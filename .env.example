# App basics
APP_NAME="DordieList"
APP_ENV=local                   # local | production
APP_KEY=                        # run: php artisan key:generate --show
APP_DEBUG=true                  # false in production
APP_TIMEZONE=UTC
APP_URL=http://dordielist.test  # set to your domain in production
ASSET_URL=http://dordielist.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode storage
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                # info/warning/error in production

# Database (MySQL/MariaDB default)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307                   # match your MySQL port
DB_DATABASE=dordielist
DB_USERNAME=root
DB_PASSWORD=

# Sessions / queues / cache
SESSION_DRIVER=database        # run: php artisan session:table && migrate
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public         # uses storage:link
QUEUE_CONNECTION=database      # run: php artisan queue:table && migrate
ARCHIVE_EXTRACT_TIMEOUT=600    # seconds; set 0 to disable ZIP extraction timeout

CACHE_STORE=database
CACHE_PREFIX=

# Redis (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail settings (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com       # or your SMTP host
MAIL_PORT=587
MAIL_USERNAME=you@example.com  # fill with real credentials
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@dordielist.com
MAIL_FROM_NAME="DORDIELIST"

# Third-party tokens (fill with your own)
ANILIST_ACCESS_TOKEN=
TMDB_API_TOKEN=
VNDB_API_TOKEN=
VNDB_USERNAME=
VNDB_PASSWORD=

# Frontend build
VITE_APP_NAME="${APP_NAME}"
